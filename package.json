{
  "name": "lossless-music-player",
  "productName": "无损音乐播放器",
  "version": "1.0.0",
  "description": "PC 版全网无损音乐播放器（对接 dl.74520.xyz，支持 FLAC 无损播放、歌词与本地下载）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --x64",
    "build": "electron-builder --win portable --x64",
    "build:mac": "electron-builder --mac dmg --arm64 --x64"
  },
  "build": {
    "appId": "com.lossless.musicplayer",
    "productName": "无损音乐播放器",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "无损音乐播放器.exe"
    },
    "portable": {
      "artifactName": "无损音乐播放器.exe"
    },
    "mac": {
      "category": "public.app-category.music",
      "icon": "assets/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "LosslessMusicPlayer-v${version}-mac-${arch}.dmg"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
